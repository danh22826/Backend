    LEFT JOIN PhongChieu ph ON s.MaPhong = ph.MaPhong
    LEFT JOIN LoaiPhong lp ON ph.MaLoaiPhong = lp.MaLoaiPhong
    WHERE s.MaPhim = ?
      AND s.NgayChieu = ?
      AND (ph.MaRap = ? OR s.MaRap = ?)
    ORDER BY s.GioChieu

^C